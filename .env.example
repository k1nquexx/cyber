# ========================================================
#  Настройки API для мода AI Companion (Cyberpunk 2077)
# ========================================================

# 1. Рекомендуется для максимальной скорости (~150 мс, 0 МБ VRAM):
# Получи бесплатный ключ на https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Быстрая флагманская модель Google Gemini 2.5 Flash:
# Получи бесплатный ключ на https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# 3. Альтернатива: DeepSeek / OpenAI / ProxyAPI
DEEPSEEK_API_KEY=
